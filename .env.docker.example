###############################################################
# .env.docker — variables for docker-compose.dev.yml (LOCAL DOCKER DEV).
# Copy to .env.docker (gitignored) and fill in APP_KEY / JWT_SECRET:
#   cp .env.docker.example .env.docker
#   # APP_KEY:    openssl rand -base64 32   (prefix the value with "base64:")
#   # JWT_SECRET: openssl rand -hex 32
# Only *.example is committed. .env.docker holds real values → NEVER commit it.
#
# This file is for the OPT-IN local Docker stack only. Native local development
# (bash scripts/dev.sh start) uses apps/api/.env with SQLite instead, and needs
# none of this. See docs/RUNNING-MODES.md.
###############################################################

# --- App ---
APP_NAME="Classly API (docker-dev)"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_TIMEZONE=UTC
APP_URL=http://localhost:8200
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi

# --- Host ports for docker-compose.dev.yml (override if a sibling project holds a port) ---
# Compose reads these from the shell or the project `.env` (NOT from this env_file):
#   API_DEV_PORT=8300 APP_DEV_PORT=3300 docker compose -f docker-compose.dev.yml up -d
API_DEV_PORT=8200
APP_DEV_PORT=3200
MYSQL_DEV_PORT=3308
REDIS_DEV_PORT=6579

# --- Database (MySQL — mirrors prod) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=classly
DB_USERNAME=classly
DB_PASSWORD=change-me-dev
# MYSQL_* is what the mysql container uses to initialise the DB and user. It MUST match DB_*
# above: Compose's ${..} substitution does NOT read env_file, so MySQL's credentials have to be
# literal here rather than ${DB_PASSWORD}. If they drift apart, MySQL creates user 'classly' with
# one password while Laravel connects with another → "Access denied".
# (MySQL only creates the user on first init — after changing it, run `down -v` to drop mysql_data.)
MYSQL_ROOT_PASSWORD=change-me-root-dev
MYSQL_DATABASE=classly
MYSQL_USER=classly
MYSQL_PASSWORD=change-me-dev

# --- Infrastructure drivers (Redis; REDIS_HOST=redis is set in compose) ---
# Dev uses predis (pure PHP, already in composer.json) so the ext-phpredis extension isn't needed.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=classly_
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail (dev = log) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@classly.io.vn"
MAIL_FROM_NAME="Classly"

# --- Auth token (JWT) ---
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# --- Fraud / client request signing: off in dev (the BFF and dev-proxy call the API directly) ---
CLIENT_SIGNATURE_ENABLED=false

# --- Hashids ---
HASHIDS_SALT=classly-dev-salt
