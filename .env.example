# ─────────────────────────────────────────────────────────────
# Compose / Docker env (root). Copy sang .env rồi điền giá trị THẬT.
#   cp .env.example .env
# File .env này được:
#   - compose dùng để thay ${BIẾN} trong docker-compose*.yml
#   - container `api`/`queue` nạp qua env_file (là .env của Laravel trong container)
# KHÔNG commit .env (đã .gitignore).
# ─────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=classly
IMAGE_TAG=latest

# ── Hostname (Traefik proxy chung route theo Host) ──
API_HOST=api.example.com
APP_HOST=app.example.com

# URL public (nướng vào Next lúc build/run)
API_PUBLIC_URL=https://api.example.com
APP_PUBLIC_URL=https://app.example.com

# Email cho Let's Encrypt (Traefik ACME) — BẮT BUỘC khi chạy shared proxy để cấp SSL.
LETSENCRYPT_EMAIL=admin@example.com

# ── Laravel (container api/queue) ──
APP_NAME="Classly"
APP_ENV=production
APP_KEY=            # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.example.com
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi

# Database dùng chung (service `mysql` ở docker-compose.shared.yml)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=classly
DB_USERNAME=classly
DB_PASSWORD=

# Redis dùng chung (service `redis`)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=classly_

# Auth JWT
JWT_SECRET=            # php artisan jwt:secret --show

# Mail
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@classly.io.vn
MAIL_FROM_NAME="Classly"

# Bảo mật client-signature (prod nên bật)
CLIENT_SIGNATURE_ENABLED=false

# Tích hợp
SEPAY_WEBHOOK_TOKEN=
SEPAY_MATCH_PATTERN=CLS
HASHIDS_SALT=

# ── Service dùng chung (docker-compose.shared.yml) ──
MYSQL_ROOT_PASSWORD=
# REDIS_PASSWORD tái dùng biến ở trên
