# apps/app (Next.js 15) — template. Copy sang .env.local (dev) hoặc .env.production.
# Kiến trúc BFF: browser -> Next route handler (server) -> Laravel qua BACKEND_URL.
# Không có secret client-side; token gắn server-side trong route handler.

# Backend Laravel (server-side)
BACKEND_URL=http://localhost:8000

# Dùng cho CSP connect-src (next.config.mjs)
API_BASE_URL=http://localhost:8000

# Public (client-side, prefix NEXT_PUBLIC_)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_VERSION=1.3.4
NEXT_PUBLIC_ENABLE_DEBUG=false
