###############################################################
# apps/api (Laravel 11) — template. Copy sang .env rồi điền giá trị.
#   cp .env.example .env && php artisan key:generate && php artisan jwt:secret
# KHÔNG bao giờ commit secret vào file này.
###############################################################

APP_NAME="Classly API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_EMAIL=no-reply@classly.io.vn

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Local: sqlite (đơn giản, không cần server). Prod: mysql.
DB_CONNECTION=sqlite
# Khi dùng mysql, bỏ comment và điền:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=classly
# DB_USERNAME=
# DB_PASSWORD=

# --- Driver hạ tầng ---
# Local không Redis: database/file. Prod: redis.
# CACHE_STORE=null  -> tắt cache hoàn toàn (khuyên dùng khi dev/test để tránh stale). Prod: redis.
CACHE_STORE=null
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Nếu dùng Redis:
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# REDIS_PORT=6379
# REDIS_PREFIX=classly_

# --- Mail ---
MAIL_MAILER=log
# Prod SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="${APP_EMAIL}"
MAIL_FROM_NAME="Classly"

# --- Auth token (JWT) ---
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# --- Chống gian lận / chữ ký client ---
# Local để false (proxy/BFF gọi thẳng). Prod bật + cấu hình allowed_clients.
CLIENT_SIGNATURE_ENABLED=false
# CLIENT_SIGNATURE_SECRET_NEXTJS=

# --- Cổng thanh toán SePay ---
SEPAY_WEBHOOK_TOKEN=
SEPAY_MATCH_PATTERN=CLS

# --- Hashids ---
HASHIDS_SALT=

# --- AI — Pro-plan AI grading & question generation ---
# Custom endpoint + model PER FEATURE. Đổi model/nhà cung cấp chỉ sửa env (không sửa code).
# Mỗi provider có `type`: anthropic (Messages API) hoặc openai (Chat Completions —
# dùng được cho OpenAI/OpenRouter/Together/Azure/local). Feature nào không set field
# nào thì kế thừa từ default.
# Local default: OFF (fail-safe). Bật ở prod với key thật.
AI_ENABLED=false
# AI_TIMEOUT=60
# AI_MAX_RETRIES=2

# Default provider (fallback cho mọi feature)
AI_TYPE=anthropic
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
# AI_ANTHROPIC_VERSION=2023-06-01   # chỉ dùng cho type=anthropic

# Per-feature override — GRADE (chấm bài, high-volume → model rẻ)
# AI_GRADE_TYPE=anthropic           # để trống = kế thừa AI_TYPE
# AI_GRADE_BASE_URL=                # để trống = kế thừa AI_BASE_URL
AI_GRADE_MODEL=claude-haiku-4-5
# AI_GRADE_KEY=                     # để trống = kế thừa key của default
# AI_GRADE_ANTHROPIC_VERSION=

# Per-feature override — GENERATE (sinh câu hỏi, mid-difficulty)
# AI_GENERATE_TYPE=anthropic
# AI_GENERATE_BASE_URL=
AI_GENERATE_MODEL=claude-sonnet-5
# AI_GENERATE_KEY=
# AI_GENERATE_ANTHROPIC_VERSION=

# Ví dụ chạy GRADE qua OpenAI-compatible endpoint:
#   AI_GRADE_TYPE=openai
#   AI_GRADE_BASE_URL=https://api.openai.com
#   AI_GRADE_MODEL=gpt-4o-mini
#   AI_GRADE_KEY=sk-...

VITE_APP_NAME="${APP_NAME}"

# Seeded super admin (php artisan db:seed). Leave the password empty to get a random one printed once.
SEED_ADMIN_EMAIL=admin@classly.io.vn
SEED_ADMIN_PASSWORD=
